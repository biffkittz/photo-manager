{
  "editor.formatOnSave": true,
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "dotnet.defaultSolution": "app/backend/PhotoManager.slnx",
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  },
  "[vue][typescript][javascript][json][jsonc][css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[terraform][terraform-vars]": {
    "editor.defaultFormatter": "hashicorp.terraform"
  },
  "eslint.workingDirectories": [
    "app/frontend"
  ],
  "prettier.prettierPath": "app/frontend/node_modules/prettier",
  "vitest.rootConfig": "app/frontend/vitest.config.ts",
  "files.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/.terraform": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "out": true
  },
  "cSpell.words": [
    "ABAC",
    "antiforgery",
    "appi",
    "azapi",
    "azuread",
    "azurerm",
    "Azurite",
    "biffkittz",
    "centralus",
    "chdir",
    "chiseled",
    "cicd",
    "ciphertext",
    "containerapp",
    "dataprotection",
    "dedupe",
    "Dependabot",
    "Entra",
    "Gemini",
    "gitleaks",
    "healthz",
    "HKDF",
    "HMAC",
    "ImageSharp",
    "joqqs",
    "Kestrel",
    "keyset",
    "NETSDK",
    "Npgsql",
    "npmrc",
    "PBKDF",
    "pgdata",
    "photomanager",
    "Pinia",
    "pmv2",
    "rdbms",
    "readyz",
    "renditions",
    "sixlabors",
    "slnx",
    "Tailwind",
    "temporalcloud",
    "Temporalio",
    "Testcontainers",
    "tfstate",
    "tfvars",
    "tmprl",
    "unwired",
    "Vitest",
    "Wasabi",
    "WCAG",
    "xmin"
  ]
}
