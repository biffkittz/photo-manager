<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Internet-facing web host: serves the Vue SPA (wwwroot) and the JSON API.
    It never holds the archive password (split-key design, see docs/adr/0001-split-keys.md).
  -->
  <PropertyGroup>
    <RootNamespace>PhotoManager.Api</RootNamespace>
    <UserSecretsId>photo-manager-api-6b1f0c55</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.GitHub" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PhotoManager.Core\PhotoManager.Core.csproj" />
    <ProjectReference Include="..\PhotoManager.Data\PhotoManager.Data.csproj" />
    <ProjectReference Include="..\PhotoManager.Infrastructure\PhotoManager.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PhotoManager.Api.Tests" />
  </ItemGroup>
</Project>
